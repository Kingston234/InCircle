# ===== PostgreSQL =====
POSTGRES_USER=gps
POSTGRES_PASSWORD=[hasło1]
POSTGRES_DB=gpstracker
DATABASE_URL=postgresql+psycopg2://gps:[hasło1]@db:5432/gpstracker

# ===== MQTT =====
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=[hasło2]

# ===== JWT =====
JWT_SECRET=[hasło3]
JWT_EXPIRES_MIN=10080

# ===== Parametry algorytmu geofencingu =====
HYSTERESIS_BUFFER_M=30      # pas histerezy wokół granicy strefy [m]
CONFIRM_SAMPLES=3           # ile kolejnych próbek potwierdza zmianę stanu
MAX_HDOP=5.0                # odrzucaj fixy o gorszym HDOP
MIN_SATS=4                  # odrzucaj fixy z mniejszą liczbą satelitów
MAX_JUMP_SPEED_KMH=200      # odrzucaj nierealne skoki pozycji
LOW_BATTERY_PCT=20          # alert, gdy bateria urządzenia spadnie poniżej [%]
TIMEZONE=Europe/Warsaw      # strefa czasowa okien aktywności geostref

# ===== FCM =====
FCM_CREDENTIALS_FILE=

# ===== pgAdmin =====
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=[hasło4]
